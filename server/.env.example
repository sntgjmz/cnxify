PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Generate a long random value, e.g. with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated URLs allowed to call the API and connect via Socket.IO.
CLIENT_ORIGINS=http://localhost:5173
# Comma-separated company email addresses that should be created as approved administrators.
ADMIN_EMAILS=admin@concentrix.com
